# ============================================================
# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会进仓库。
#   cp .env.example .env
# ============================================================

# ---------- LLM（OpenAI 兼容中转 / OpenRouter）----------
# 注意：OpenRouter 只提供 chat/completions，没有 embeddings 接口。
# 本项目向量化一律走本地 BGE-M3，不依赖远端 embedding。
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# 主力对话模型（按你的中转站实际可用模型改）
LLM_MODEL=deepseek/deepseek-chat
# 备用/廉价模型，用于批量标注、自评等低成本场景
LLM_MODEL_CHEAP=deepseek/deepseek-chat
# 主模型返回空正文时降级用的备用模型（留空 = 不降级）
LLM_BACKUP_MODEL=
# 是否允许模型思考。408 问答实测关闭后首字延迟从 44s 降到 1.6s
LLM_ENABLE_THINKING=false

# ---------- 对抗 Plan 的角色模型（留空走默认链）----------
# 三个角色分开用模型，避免同一模型自证：
#   Planner 生成 -> LLM_MODEL
#   Critic  挑错 -> LLM_BACKUP_MODEL（空回答率更低）
#   Expert  裁定 -> LLM_MODEL（与 Critic 形成独立意见）
# 如果中转站有第三个稳定模型，可以在这里覆盖 Expert。
ADV_PLANNER_MODEL=
ADV_CRITIC_MODEL=
ADV_EXPERT_MODEL=

# ---------- 多模态（二期图表题 Tier3，可选）----------
# 你的中转站若没有视觉模型，留空即可，read_figure 会跳过 Tier3 降级到 SVG 方案
VLM_MODEL=

# ---------- 网络（本项目实测结论，勿随意改动）----------
# huggingface.co 与 raw.githubusercontent.com 在本机不可达，
# 模型下载必须走 hf-mirror；代码里的下载脚本走 codeload.github.com
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=./models/hf

# ---------- 本地模型 ----------
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=8

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cs408_chunks

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cs408rag_dev_pw

# ---------- 检索默认参数（消融实验会覆盖这些值）----------
RETRIEVE_TOP_K=20
FUSION_TOP_K=50
RERANK_TOP_N=10
RRF_K=60

# ---------- 评测防泄漏隔离 ----------
# held-out 年份：这些年份的真题解析禁止入索引，只用于最终评测
HOLDOUT_YEARS=2023,2024,2025,2026

# ---------- 服务 ----------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO